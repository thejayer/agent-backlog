# Copy to .env (or export these) and adjust. All are optional for local dev.

# --- Server ---
PORT=4186
HOST=127.0.0.1
# NODE_ENV=production            # in production, the auth vars below are required
# MANAGE_BASE_URL=https://board.example.com

# --- Auth ---
# Bearer token coding agents send as: Authorization: Bearer <token>
# Defaults to "manage-local" when unset (development only).
MANAGE_AUTH_TOKEN=manage-local
# Secret used to sign browser session cookies. Set a long random value in prod.
# MANAGE_AUTH_SECRET=change-me-to-a-long-random-string
# MANAGE_COOKIE_SECURE=true       # send Secure cookies (auto-on when BASE_URL is https)

# --- Optional: GitHub OAuth for the human console ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MANAGE_ALLOWED_GITHUB_LOGINS=your-github-login   # comma-separated allowlist

# --- Optional: GitHub sync (read-only repo health) ---
# Without a token the app falls back to the `gh` CLI if present.
# GITHUB_TOKEN=

# --- Storage ---
# "file" (default) writes JSON under manage/data/. "firestore" uses GCP.
MANAGE_STORAGE_BACKEND=file
# MANAGE_DATA_DIR=./manage/data
# MANAGE_SNAPSHOT_RETENTION=25

# --- Optional: Firestore backend ---
# Requires `npm i @google-cloud/firestore` (installed as an optional dependency).
# MANAGE_STORAGE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# MANAGE_FIRESTORE_COLLECTION=manage_state
