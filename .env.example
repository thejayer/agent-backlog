# Copy to .env (or export these) and adjust. All are optional for local dev.

# --- Server ---
PORT=4186
HOST=127.0.0.1
# NODE_ENV=production            # in production, required secrets below must be set
# MANAGE_BASE_URL=https://board.example.com
# MANAGE_ALLOWED_ORIGINS=https://board.example.com

# --- Auth ---
# Agent bearer token. Coding agents send: Authorization: Bearer <token>
# Defaults to "manage-local-agent" when unset (development only).
# Cannot mint a browser session.
MANAGE_AUTH_TOKEN=manage-local-agent
# Operator / break-glass token for the human console.
# Must differ from MANAGE_AUTH_TOKEN. Defaults to "manage-local" in development.
# In production, omit this and use GitHub OAuth, or set a distinct token.
# MANAGE_OPERATOR_TOKEN=manage-local
# Secret used to sign browser session cookies. Set a long random value in prod.
# MANAGE_AUTH_SECRET=change-me-to-a-long-random-string
# MANAGE_COOKIE_SECURE=true       # send Secure cookies (auto-on when BASE_URL is https)

# --- Optional: GitHub OAuth for the human console ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MANAGE_ALLOWED_GITHUB_LOGINS=your-github-login   # comma-separated allowlist; config-only, no product default

# --- Optional: GitHub sync (read-only repo health) ---
# Without a token the app falls back to the `gh` CLI if present.
# GITHUB_TOKEN=

# --- Storage ---
# "file" (default) writes JSON under manage/data/. "firestore" uses GCP.
MANAGE_STORAGE_BACKEND=file
# MANAGE_DATA_DIR=./manage/data
# MANAGE_SNAPSHOT_RETENTION=25
# Packet keys are TASK-N. Override only if you need a different prefix.
# MANAGE_PACKET_KEY_PREFIX=TASK

# --- Optional: Firestore backend ---
# Requires `npm i @google-cloud/firestore` (installed as an optional dependency).
# Stores one document per packet plus a work-items-counter for the next TASK-N key.
# Snapshots larger than ~1 MB are split into chunk documents automatically.
# MANAGE_STORAGE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# MANAGE_FIRESTORE_COLLECTION=manage_state
# MANAGE_FIRESTORE_WORK_ITEMS_COLLECTION=manage_state_work_items
# MANAGE_FIRESTORE_SNAPSHOT_COLLECTION=manage_state_snapshots
# MANAGE_FIRESTORE_PACKET_EVENT_COLLECTION=manage_state_packet_events
# MANAGE_FIRESTORE_SNAPSHOT_MAX_BYTES=850000

# --- Optional: Packet room GitHub ingest ---
# When set, POST /api/packet-events/github also requires a valid X-Hub-Signature-256.
# MANAGE_GITHUB_WEBHOOK_SECRET=
