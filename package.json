    "manage:serve": "node manage/server.mjs",
    "manage:preview": "vite preview --config manage/vite.config.mjs --host 127.0.0.1",
    "manage:test": "playwright test --config manage/playwright.config.mjs",
    "manage:agent": "node scripts/manage-agent.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
